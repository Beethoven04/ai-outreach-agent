# Copy to finder/.env (git-ignored) and fill in.

# Google Sheet tracker (the long ID in the sheet URL) + service account key file (docs/04_google_service_account.md)
SHEET_ID=
SERVICE_ACCOUNT=service_account.json

# Self-hosted Reacher (server/README.md). Through an SSH tunnel: http://127.0.0.1:8080
REACHER_URL=
REACHER_SECRET=

# Optional second-opinion verifier when Reacher answers "unknown" (free tier: 20 checks/day)
REOON_KEY=
